[Unit]
Description=SkillMCP Node and MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skillmcp
Group=skillmcp
WorkingDirectory=/srv/skillmcp/current
EnvironmentFile=/etc/skillmcp/skillmcp.env
Environment=HOST=127.0.0.1
ExecStart=/usr/local/bin/node server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/skillmcp

[Install]
WantedBy=multi-user.target
